class CrowdinAT5 < Formula
  desc "Command-line tool to manage and synchronize localization resources with Crowdin"
  homepage "https://crowdin.github.io/crowdin-cli/"
  version "<%= version %>"
  license "MIT"

  # Generated by the publish workflow from .github/templates/crowdin@5.rb.erb.
  # Edit the template, not this file.
  on_macos do
    on_arm do
      url "https://github.com/crowdin/crowdin-cli/releases/download/<%= version %>/crowdin-darwin-arm64"
      sha256 "<%= sha["darwin-arm64"] %>"
    end
    on_intel do
      url "https://github.com/crowdin/crowdin-cli/releases/download/<%= version %>/crowdin-darwin-x64"
      sha256 "<%= sha["darwin-x64"] %>"
    end
  end
  on_linux do
    on_arm do
      url "https://github.com/crowdin/crowdin-cli/releases/download/<%= version %>/crowdin-linux-arm64"
      sha256 "<%= sha["linux-arm64"] %>"
    end
    on_intel do
      url "https://github.com/crowdin/crowdin-cli/releases/download/<%= version %>/crowdin-linux-x64"
      sha256 "<%= sha["linux-x64"] %>"
    end
  end

  livecheck do
    skip "Prerelease channel, updated by CI"
  end

  conflicts_with "crowdin", because: "both install a `crowdin` executable"

  def install
    binary = Dir["crowdin-*"].fetch(0)
    bin.install binary => "crowdin"
    chmod 0555, bin/"crowdin"
  end

  test do
    assert_equal version.to_s, shell_output("#{bin}/crowdin --version").strip
  end
end
